# ─── GreenChain Mobile — public environment variables ────────────────────────
#
# Rules:
#   1. Only EXPO_PUBLIC_* values are bundled into the app JS bundle at build time.
#   2. NEVER put private keys, backend secrets, DB URLs, or webhook secrets here.
#      Anything in this file ships inside the APK/AAB and can be extracted by
#      anyone who installs the app.
#   3. The API base URL MUST use HTTPS for preview/production builds.
#      LAN IPs like http://192.168.x.x:8000 are for local development only.
#   4. Copy this file to `mobile/.env` and fill in real values locally.
#      Never commit the real `.env`.

# ─── Backend API ─────────────────────────────────────────────────────────────
# Development: http://<your-lan-ip>:8000
# Preview/production: https://<your-deployed-backend-domain>
EXPO_PUBLIC_API_BASE_URL=

# ─── Google Maps SDK (Android only) ──────────────────────────────────────────
# Restrict this key in Google Cloud Console:
#   Application restriction: Android apps
#   Package name:            com.greenchain.app
#   SHA-1:                   the fingerprint from `eas credentials -p android`
#   API restriction:         Maps SDK for Android
# Injected into AndroidManifest at build time by app.config.js.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# ─── Google OAuth (optional, off by default) ────────────────────────────────
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_DEBUG=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ─── Razorpay Checkout (public key only) ────────────────────────────────────
# This is the client-side key ID (rzp_test_* or rzp_live_*).
# The KEY SECRET must live on the backend only — never here.
EXPO_PUBLIC_RAZORPAY_KEY_ID=
