# ─── GreenChain Backend — environment variables ─────────────────────────────
# Copy this file to backend/.env and fill in real values locally.
# NEVER commit the real .env. Never commit real secrets to source control.
# Production deployments should read these values from the hosting provider's
# secrets manager (Render env vars, Railway variables, AWS Secrets Manager, etc.)

# ─── App environment ────────────────────────────────────────────────────────
# development / dev / test / testing  → relaxed startup validation
# staging / production / prod         → strict validation (SECRET_KEY + CORS_ORIGINS required)
APP_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/greenchain

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Staging/production: MUST be a real random value, at least 32 characters,
# and NOT the placeholder string below. Startup will refuse otherwise.
# Local dev: any non-empty value; if unset, a documented dev-only fallback is
# used so the process boots (fallback is NEVER accepted in staging/prod).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Blockchain ──────────────────────────────────────────────────────────────
# BLOCKCHAIN_MODE=mock  → in-memory provider (no chain calls, safe for tests/dev)
# BLOCKCHAIN_MODE=web3  → Polygon Amoy testnet (requires the WEB3_* vars below)
BLOCKCHAIN_MODE=web3
WEB3_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
WEB3_CONTRACT_ADDRESS=0xYourDeployedContractAddress
WEB3_CHAIN_ID=80002
WEB3_ACCOUNT_ADDRESS=0xYourFPOCustodialWalletAddress
WEB3_PRIVATE_KEY=YOUR_FPO_CUSTODIAL_WALLET_PRIVATE_KEY

# ─── Payout Provider — Razorpay ──────────────────────────────────────────────
# RAZORPAY_MODE=mock  → simulated payouts (default, safe)
# RAZORPAY_MODE=test  → RazorpayX test mode (requires test credentials)
# RAZORPAY_MODE=live  → production (requires live credentials — DO NOT commit)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
# Safety flag: MUST remain false unless full test-payout flow has been reviewed.
RAZORPAY_ENABLE_TEST_PAYOUTS=false
# Razorpay webhook HMAC secret (used to verify inbound payment webhooks).
RAZORPAY_WEBHOOK_SECRET=

# ─── AI Layer ────────────────────────────────────────────────────────────────
# AI_MODE=rules  → deterministic rule engine (default, no external deps)
# AI_MODE=groq   → Groq cloud LLM (falls back to rules if unavailable)
AI_MODE=rules
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Google OAuth (optional, off by default) ────────────────────────────────
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Path to Google service-account JSON if using server-to-server auth.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Storage & serving ──────────────────────────────────────────────────────
# Absolute directory for evidence uploads. Must be writable and persistent.
# Local dev: leave empty → backend uses <backend>/uploads/evidence
# Render:    /var/data/uploads/evidence (under the mounted persistent disk)
UPLOAD_DIR=
# Public URL where uploaded files are served from (used to build download links).
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed browser origins for CORS.
# Format: https://a.example,https://b.example  (whitespace is trimmed)
# Dev/test: empty → falls back to "*" for local convenience.
# Staging/production: MUST be an explicit list. "*" is rejected because
# allow_credentials is enabled. React Native does not require CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
